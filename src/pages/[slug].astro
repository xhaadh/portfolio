---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.data.slug }, props: { project: p.data } }));
}

const { project } = Astro.props;

/** Thumbnail generated by scripts/fetch-placeholders.mjs, falling back to the full image. */
function thumbOf(src: string) {
  const thumb = src.replace(/\/([^/]+)\.\w+$/, '/thumbs/$1.webp');
  return existsSync(join(process.cwd(), 'public', thumb)) ? thumb : src;
}
---

<Base
  page="project"
  slug={project.slug}
  title={project.titleMixedCase}
  description={project.description}
  bg={project.color}
  fg={project.textColor}
  image={project.cover}
>
  <main id="page" class="proj" style={`--pcolor:${project.color}`}>
    <a class="proj__back" href="/" aria-label="Back to projects">
      <span class="proj__x" aria-hidden="true"><span data-mask-in>×</span></span>
      <span class="ulink is-underlined"><span class="ulink__in">Projects</span></span>
    </a>

    <h1 class="proj__title">{project.title}</h1>

    <div class="proj__media">
      <img
        src={project.cover}
        alt={`${project.titleMixedCase} — main image`}
        width="1600"
        height="1000"
        decoding="async"
        fetchpriority="high"
      />
      <div class="proj__wipe" aria-hidden="true"></div>
    </div>

    <ul class="proj__thumbs" aria-label="Images">
      {
        project.images.map((src, i) => (
          <li>
            <button
              class:list={['pthumb', { 'is-active': i === 0 }]}
              type="button"
              aria-label={`Show image ${i + 1} of ${project.images.length}`}
              aria-current={i === 0 ? 'true' : 'false'}
            >
              <span class="pthumb__in">
                <img src={thumbOf(src)} alt="" width="160" height="100" loading="lazy" decoding="async" />
              </span>
            </button>
          </li>
        ))
      }
    </ul>

    <div class="proj__info">
      <dl class="proj__meta">
        <dt data-line>Completed</dt>
        <dd data-line>{project.completed}</dd>
        <dt data-line>Type</dt>
        <dd data-line>{project.type}</dd>
        <dt data-line>Role</dt>
        <dd data-line>{project.role}</dd>
        <dt data-line>Client</dt>
        <dd data-line>{project.client}</dd>
      </dl>
      <p class="proj__desc">{project.description}</p>
      {
        project.url && (
          <p class="proj__visit m-0">
            <a class="ulink" href={project.url} target="_blank" rel="noopener">
              <span class="ulink__in">
                Visit site <Arrow />
              </span>
            </a>
          </p>
        )
      }
    </div>
  </main>
</Base>
