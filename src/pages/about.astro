---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base page="about" title="About" description={site.description}>
  <main id="page" class="about">
    <h1 class="about__heading" aria-label={`About ${site.name}`}>
      {site.aboutHeading.map((line) => <span class="about__heading-line">{line}</span>)}
    </h1>

    <div class="about__cols">
      <section class="about__col" aria-labelledby="experience-title">
        <h2 id="experience-title" data-line>Experience</h2>
        {
          site.experience.map((exp) => (
            <ul class="about__group m-0 list-none p-0">
              <li data-line class="opacity-60">{exp.period}</li>
              <li data-line class="font-medium">{exp.role}</li>
              <li data-line class="opacity-80">{exp.company}</li>
              <li data-line class="opacity-50 text-xs">{exp.location}</li>
            </ul>
          ))
        }

        <div class="mt-8">
          <ul class="about__group m-0 list-none p-0">
            <li data-line class="opacity-60">Education</li>
            <li data-line class="font-medium">{site.education.degree}</li>
            <li data-line class="opacity-80">{site.education.institution}</li>
            <li data-line class="opacity-50 text-xs">{site.education.period}</li>
          </ul>
        </div>
      </section>

      <section class="about__col" aria-labelledby="skills-title">
        <h2 id="skills-title" data-line>Skills & Stack</h2>
        {
          site.skills.map((group) => (
            <ul class="about__group m-0 list-none p-0">
              <li data-line class="opacity-60">{group.category}</li>
              {group.items.map((skill) => (
                <li data-line>{skill}</li>
              ))}
            </ul>
          ))
        }
      </section>
    </div>
  </main>
</Base>
