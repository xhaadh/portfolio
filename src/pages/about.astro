---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

// Clients grouped by first letter (A, B, D, ...).
const groups = Object.entries(
  [...site.clients]
    .sort((a, b) => a.localeCompare(b))
    .reduce<Record<string, string[]>>((acc, c) => {
      const k = c[0].toUpperCase();
      (acc[k] ||= []).push(c);
      return acc;
    }, {}),
);
---

<Base page="about" title="About" description={site.description}>
  <main id="page" class="about">
    <h1 class="about__heading" aria-label={`About ${site.name}`}>
      {site.aboutHeading.map((line) => <span class="about__heading-line">{line}</span>)}
    </h1>

    <div class="about__cols">
      <section class="about__col" aria-labelledby="clients-title">
        <h2 id="clients-title" data-line>Clients</h2>
        {
          groups.map(([letter, names]) => (
            <ul class="about__group m-0 list-none p-0">
              <li data-line aria-hidden="true">{letter}</li>
              {names.map((n) => (
                <li data-line>{n}</li>
              ))}
            </ul>
          ))
        }
      </section>

      <section class="about__col" aria-labelledby="awards-title">
        <h2 id="awards-title" data-line>Awards</h2>
        {
          site.awards.map((g) => (
            <ul class="about__group m-0 list-none p-0">
              <li data-line class="opacity-60">{g.org}</li>
              {g.items.map((a) => (
                <li data-line>
                  <span class="about__award">
                    <span>{a.count}</span>
                    <span>{a.label}</span>
                  </span>
                </li>
              ))}
            </ul>
          ))
        }
      </section>
    </div>
  </main>
</Base>
